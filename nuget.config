<?xml version="1.0" encoding="utf-8"?>
<!--
  Guards against a hijacked or malicious package release: dotnet package add (without a version) and dotnet package
  update skip any version published less than 72 hours ago, which is usually long enough for a bad release to be
  caught and unlisted. Restore of the pinned versions in Directory.Packages.props is not affected, and naming a
  version explicitly still takes it, so a release that is needed sooner can be adopted on purpose.
  https://learn.microsoft.com/nuget/consume-packages/minimum-package-publish-age
-->
<configuration>
  <packageSources>
    <!-- Only nuget.org, so a source from a user or machine config cannot bypass the delay. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" minPublishAgeHours="72" />
  </packageSources>
  <!-- Empty, so exceptions from a user or machine config cannot exempt packages either. -->
  <minPublishAgeExceptions />
</configuration>
